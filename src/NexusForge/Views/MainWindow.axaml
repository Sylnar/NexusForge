<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sylnar.ViewModels"
        xmlns:ctrl="using:Sylnar.Views.Controls"
        xmlns:pages="using:Sylnar.Views.Pages"
        xmlns:h="using:Sylnar.Helpers"
        x:Class="Sylnar.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{x:Static h:VersionInfo.WindowTitle}"
        Width="1100" Height="680"
        MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgAppBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

  <!--
    Sidebar (200px) | page + log dock. The log dock sits at the bottom of the
    page column and can be collapsed to its toolbar. Pages stay alive while
    hidden so inputs and results survive switching.
  -->
  <Grid ColumnDefinitions="200,*">

    <ctrl:Sidebar Grid.Column="0" />

    <DockPanel Grid.Column="1">
      <ctrl:LogDock DockPanel.Dock="Bottom" />

      <Panel>
        <pages:BoardFlashPage IsVisible="{Binding IsBoardPage}" />
        <Panel IsVisible="{Binding IsDriversPage}">
          <pages:DriversPage DataContext="{Binding Driver}" />
        </Panel>
        <Panel IsVisible="{Binding IsDmaPage}">
          <pages:DmaTestPage DataContext="{Binding DmaTest}" />
        </Panel>
        <Panel IsVisible="{Binding IsProbePage}">
          <pages:BarProbePage DataContext="{Binding BarProbe}" />
        </Panel>
      </Panel>
    </DockPanel>

  </Grid>
</Window>
