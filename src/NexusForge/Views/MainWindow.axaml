<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sylnar.ViewModels"
        xmlns:ctrl="using:Sylnar.Views.Controls"
        xmlns:h="using:Sylnar.Helpers"
        x:Class="Sylnar.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{x:Static h:VersionInfo.WindowTitle}"
        Width="980" Height="900"
        MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Foreground="#E6EDF3">
  <Window.Background>
    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#0F141B" Offset="0"/>
      <GradientStop Color="#0B0F15" Offset="1"/>
    </LinearGradientBrush>
  </Window.Background>
  <!-- Was a fixed 950x960 non-resizable window: taller than a 1080p laptop
       screen at 125% scaling, so the bottom of the log was cut off. Tabs now
       scroll, and the window can shrink to 680px high. -->

  <Window.Styles>

    <!-- ── Shared button chrome: smooth hover/press colour changes ── -->
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background"  Duration="0:0:0.14" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
          <BrushTransition Property="Foreground"  Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Keyboard focus ring (Tab navigation), hidden for mouse clicks -->
    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush"     Value="#7FF2DA"/>
      <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <!-- NB: Fluent's own :pointerover/:pressed states restyle the template's
         ContentPresenter (and flip the text to white), so hover colours must
         target the presenter, not the Button itself. -->

    <!-- ── Primary button ── -->
    <Style Selector="Button.primary">
      <Setter Property="Background"      Value="#00D4AA"/>
      <Setter Property="Foreground"      Value="#06231D"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="CornerRadius"    Value="7"/>
      <Setter Property="Padding"         Value="16,7"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1FE3BC"/>
      <Setter Property="Foreground" Value="#06231D"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#00B894"/>
      <Setter Property="Foreground" Value="#06231D"/>
    </Style>

    <!-- ── Teal outline ── -->
    <Style Selector="Button.teal-outline">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="Foreground"      Value="#00D4AA"/>
      <Setter Property="BorderBrush"     Value="#00D4AA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"    Value="7"/>
      <Setter Property="Padding"         Value="12,5"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="Cursor"          Value="Hand"/>
    </Style>
    <Style Selector="Button.teal-outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background"  Value="#1A00D4AA"/>
      <Setter Property="BorderBrush" Value="#1FE3BC"/>
      <Setter Property="Foreground"  Value="#1FE3BC"/>
    </Style>
    <Style Selector="Button.teal-outline:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background"  Value="#2E00D4AA"/>
      <Setter Property="BorderBrush" Value="#00D4AA"/>
      <Setter Property="Foreground"  Value="#00D4AA"/>
    </Style>

    <!-- ── Danger outline ── -->
    <Style Selector="Button.danger-outline">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="Foreground"      Value="#F85149"/>
      <Setter Property="BorderBrush"     Value="#F85149"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"    Value="7"/>
      <Setter Property="Padding"         Value="16,7"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="Cursor"          Value="Hand"/>
    </Style>
    <Style Selector="Button.danger-outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background"  Value="#1AF85149"/>
      <Setter Property="BorderBrush" Value="#FF7B72"/>
      <Setter Property="Foreground"  Value="#FF7B72"/>
    </Style>
    <Style Selector="Button.danger-outline:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background"  Value="#2EF85149"/>
      <Setter Property="BorderBrush" Value="#F85149"/>
      <Setter Property="Foreground"  Value="#F85149"/>
    </Style>

    <!-- ── Ghost ── -->
    <Style Selector="Button.ghost">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="Foreground"      Value="#8B949E"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius"    Value="6"/>
      <Setter Property="Padding"         Value="9,4"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="Cursor"          Value="Hand"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#21262D"/>
      <Setter Property="Foreground" Value="#E6EDF3"/>
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#30363D"/>
      <Setter Property="Foreground" Value="#E6EDF3"/>
    </Style>

    <!-- ── Disabled ── -->
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.35"/>
      <Setter Property="Cursor"  Value="Arrow"/>
    </Style>

    <!-- ── Cards: every section panel is a #161B22 border; lift it off the
         background with a soft shadow ── -->
    <Style Selector="Border.card">
      <Setter Property="BoxShadow" Value="0 4 18 0 #33000000"/>
    </Style>

    <!-- ── CheckBox ── -->
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#8B949E"/>
      <Setter Property="FontSize"   Value="12"/>
    </Style>

    <!-- ── ProgressBar: teal-to-cyan fill ── -->
    <Style Selector="ProgressBar">
      <Setter Property="Background"   Value="#21262D"/>
      <Setter Property="Height"       Value="8"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="MinHeight"    Value="8"/>
      <Setter Property="Foreground">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Color="#00D4AA" Offset="0"/>
          <GradientStop Color="#38BDF8" Offset="1"/>
        </LinearGradientBrush>
      </Setter>
    </Style>

    <!-- ── TabControl chrome ── -->
    <Style Selector="TabControl">
      <Setter Property="Background"   Value="Transparent"/>
      <Setter Property="Padding"      Value="0"/>
    </Style>
    <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Margin" Value="12,6,12,0"/>
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Background"   Value="Transparent"/>
      <Setter Property="Foreground"   Value="#6E7681"/>
      <Setter Property="FontSize"     Value="12"/>
      <Setter Property="FontWeight"   Value="SemiBold"/>
      <Setter Property="Padding"      Value="14,10"/>
      <Setter Property="MinHeight"    Value="40"/>
      <Setter Property="Cursor"       Value="Hand"/>
      <Setter Property="Margin"       Value="0,0,2,0"/>
      <Setter Property="CornerRadius" Value="7,7,0,0"/>
    </Style>
    <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="#161B22"/>
    </Style>
    <Style Selector="TabItem:pointerover">
      <Setter Property="Foreground"   Value="#C9D1D9"/>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground"   Value="#E6EDF3"/>
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="#161B22"/>
    </Style>

    <!-- ── Text inputs: stay dark on hover/focus (Fluent lightens them),
         teal border when focused ── -->
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background"  Value="#0D1117"/>
      <Setter Property="BorderBrush" Value="#484F58"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background"      Value="#0D1117"/>
      <Setter Property="BorderBrush"     Value="#00D4AA"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBox:pointerover">
      <Setter Property="Foreground" Value="#E6EDF3"/>
    </Style>

    <!-- ── Slim scrollbars for the scrolling tabs ── -->
    <Style Selector="ScrollViewer.tab-scroll">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
    </Style>

  </Window.Styles>

  <!--
    DockPanel layout — items dock in order:
      1. Header       → Top    (fixed height)
      2. StatusBar    → Bottom (fixed height)
      3. StatusLog    → Bottom (fixed 200px)
      4. TabControl   → Fill   (takes ALL remaining space)
    This guarantees the log never pushes tab content up.
  -->
  <DockPanel LastChildFill="True">

    <!-- ─── 1. HEADER — docked top ─── -->
    <ctrl:HeaderControl DockPanel.Dock="Top" DataContext="{Binding}" />

    <!-- ─── 2. STATUS BAR — docked bottom ─── -->
    <Border DockPanel.Dock="Bottom"
            Background="#161B22"
            BorderBrush="#21262D"
            BorderThickness="0,1,0,0"
            Padding="20,7">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusBarText}"
                   Foreground="#484F58" FontSize="11"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="#3FB950" VerticalAlignment="Center"/>
          <TextBlock Text="System Ready" Foreground="#484F58" FontSize="11" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ─── 3. STATUS LOG — docked bottom, FIXED 200px height ─── -->
    <ctrl:StatusLogPanel DockPanel.Dock="Bottom"
                         DataContext="{Binding}"
                         Height="200"
                         Margin="12,4,12,8" />

    <!-- ─── 4. TAB CONTROL — fills all remaining space ─── -->
    <TabControl Background="Transparent" Margin="0">

      <!-- ═══ Tab 1: BOARD & FLASH ═══ -->
      <TabItem Header="BOARD &amp; FLASH">
        <ScrollViewer Classes="tab-scroll">
        <StackPanel>
          <ctrl:BoardInfoPanel DataContext="{Binding BoardInfo}" Margin="12,8,12,0" />
          <ctrl:FlashPanel     DataContext="{Binding Flash}"     Margin="12,10,12,8"  />
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ═══ Tab 2: DRIVER MANAGER ═══ -->
      <TabItem Header="DRIVER MANAGER">
        <ScrollViewer Classes="tab-scroll">
        <StackPanel>
          <ctrl:DriverPanel DataContext="{Binding Driver}" Margin="12,8,12,6" />

            <!-- Info card -->
            <Border Classes="card"
                    Background="#161B22"
                    BorderBrush="#21262D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="12,0,12,8"
                    Padding="16,14">
              <StackPanel Spacing="10">

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Background="#9E6A03" Width="3" CornerRadius="2" />
                  <TextBlock Text="HOW IT WORKS"
                             FontSize="11" FontWeight="SemiBold"
                             Foreground="#E6EDF3" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Foreground="#8B949E" FontSize="12" TextWrapping="Wrap">
                    Sylnar uses OpenOCD to communicate with DMA boards via the
                    CH347 USB-JTAG chip. The WCH CH347 driver MUST be installed for this to work.
                    Without it, OpenOCD cannot access the JTAG interface.
                  </TextBlock>
                  <TextBlock Foreground="#8B949E" FontSize="12" TextWrapping="Wrap">
                    Install: Sylnar adds the bundled, signed WCH driver to the Windows
                    driver store (pnputil /add-driver) and rescans devices so it binds
                    immediately. Administrator rights are required. If Windows asks for a
                    restart, the driver finishes installing after the reboot.
                  </TextBlock>
                  <Border Background="#1C2333" CornerRadius="6" Padding="12,8" Margin="0,4,0,0">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Official WCH resources (verified April 2024):"
                                 Foreground="#6E7681" FontSize="11" FontWeight="SemiBold" />
                      <TextBlock Foreground="#58A6FF" FontSize="11"
                                 FontFamily="Consolas,Courier New,monospace">
                        https://github.com/WCHSoftGroup/ch347
                      </TextBlock>
                      <TextBlock Text="Release: CH347_OpenOCD_Release — contains OpenOCD binary and CH347FPGATool"
                                 Foreground="#6E7681" FontSize="11" />
                    </StackPanel>
                  </Border>
                </StackPanel>

              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ═══ Tab 3: BAR PROBE ═══ -->
      <TabItem Header="BAR PROBE">
        <ScrollViewer Classes="tab-scroll">
        <StackPanel>
          <ctrl:BarProbePanel DataContext="{Binding BarProbe}" Margin="12,8,12,6" />

          <!-- Info card -->
          <Border Classes="card"
                  Background="#161B22"
                  BorderBrush="#21262D"
                  BorderThickness="1"
                  CornerRadius="8"
                  Margin="12,0,12,8"
                  Padding="16,14">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Background="#A371F7" Width="3" CornerRadius="2" />
                <TextBlock Text="ABOUT BAR PROBE"
                           FontSize="11" FontWeight="SemiBold" Foreground="#E6EDF3" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Foreground="#8B949E" FontSize="12" TextWrapping="Wrap">
                  Reads physical memory through the FPGA's DMA engine. Useful for
                  inspecting host RAM, other PCIe devices' BAR memory (NIC, GPU,
                  storage controllers), and anything the OS exposes in the physical
                  address space.
                </TextBlock>
                <TextBlock Foreground="#8B949E" FontSize="12" TextWrapping="Wrap">
                  <Run FontWeight="SemiBold" Foreground="#E3B341">Limitation:</Run>
                  The DMA card cannot read its OWN BAR memory via this path on
                  most chipsets (PCIe self-loopback / peer-to-peer routing is
                  usually blocked). Use "Read DMA Config Space" instead — it uses
                  Type 0 config TLPs which the root complex always routes correctly.
                </TextBlock>
                <TextBlock Foreground="#8B949E" FontSize="12" TextWrapping="Wrap">
                  Helpers:
                  <LineBreak/>
                  • <Run FontWeight="SemiBold">Test FPGA Link</Run> — reads system RAM at 0x100000, confirms FTDI + leechcore + FPGA chain works
                  <LineBreak/>
                  • <Run FontWeight="SemiBold">Read DMA Config Space</Run> — reads the FPGA's own PCIe config space (vendor/device IDs, BARs, capabilities, DSN)
                  <LineBreak/>
                  • <Run FontWeight="SemiBold">List PCIe Devices</Run> — enumerates host PCIe devices + their BAR address ranges so you can pick a target without hunting in Device Manager
                </TextBlock>
                <TextBlock Foreground="#8B949E" FontSize="12" TextWrapping="Wrap">
                  Polling: appends a timestamped hex dump to the log file every
                  Period(ms). When the FPGA loses connection (target PC freezes /
                  reboots / cable unplugged), the poll loop detects consecutive
                  failures and stops cleanly. The log file is preserved on this PC.
                </TextBlock>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ═══ Tab 4: DMA TESTING ═══ -->
      <TabItem Header="DMA TESTING">
        <ScrollViewer Classes="tab-scroll">
          <StackPanel>
            <ctrl:DmaTestPanel DataContext="{Binding DmaTest}" Margin="12,8,12,6" />

          <!-- Info card -->
          <Border Classes="card"
                  Background="#161B22"
                  BorderBrush="#21262D"
                  BorderThickness="1"
                  CornerRadius="8"
                  Margin="12,0,12,8"
                  Padding="16,14">
            <StackPanel Spacing="10">

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Background="#E3B341" Width="3" CornerRadius="2" />
                <TextBlock Text="ABOUT DMA SPEED TESTING"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#E6EDF3" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Foreground="#8B949E" FontSize="12" TextWrapping="Wrap">
                  Sylnar tests DMA read performance through the FPGA board's FT601 data port.
                  The FTDI SuperSpeed driver must be installed and the board must have PCILeech-compatible
                  firmware loaded (flash + cold reboot required).
                </TextBlock>
                <TextBlock Foreground="#8B949E" FontSize="12" TextWrapping="Wrap">
                  Full Test: process lookup + latency (4KB reads) + throughput (16MB reads).
                  Latency Test: 30 seconds of 4KB random reads — measures RPS and per-read timing.
                  Throughput Test: 15 seconds of 16MB sequential reads — measures sustained MB/s.
                  Stress Test: long-duration soak (default 5 min, configurable 1-60 min) mixing
                  4KB and 16MB reads, tracking failures and the longest consecutive-failure streak.
                  Reports PASS if the DMA path stays stable for the whole duration.
                </TextBlock>
                <Border Background="#1C2333" CornerRadius="6" Padding="12,8" Margin="0,4,0,0">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Rating Scale:" Foreground="#6E7681" FontSize="11" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                      <TextBlock Foreground="#3FB950" FontSize="11" FontFamily="Consolas,Courier New,monospace">PERFECT</TextBlock>
                      <TextBlock Foreground="#58A6FF" FontSize="11" FontFamily="Consolas,Courier New,monospace">EXCELLENT</TextBlock>
                      <TextBlock Foreground="#E3B341" FontSize="11" FontFamily="Consolas,Courier New,monospace">GOOD</TextBlock>
                      <TextBlock Foreground="#D29922" FontSize="11" FontFamily="Consolas,Courier New,monospace">ACCEPTABLE</TextBlock>
                      <TextBlock Foreground="#F85149" FontSize="11" FontFamily="Consolas,Courier New,monospace">FAIL</TextBlock>
                    </StackPanel>
                    <TextBlock Foreground="#6E7681" FontSize="11" TextWrapping="Wrap">
                      Latency: PERFECT 18K+ RPS | EXCELLENT 6K+ | GOOD 4K+ | ACCEPTABLE 3K+
                    </TextBlock>
                    <TextBlock Foreground="#6E7681" FontSize="11" TextWrapping="Wrap">
                      Throughput: PERFECT 600+ MB/s | EXCELLENT 200+ | GOOD 150+ | ACCEPTABLE 100+
                    </TextBlock>
                  </StackPanel>
                </Border>
              </StackPanel>

            </StackPanel>
          </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

  </DockPanel>
</Window>
