<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sylnar.Views.UpdateWindow"
        Title="Updating Sylnar"
        Width="440" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True">

  <Border CornerRadius="16" ClipToBounds="True">
    <Border.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#0D1015" Offset="0"/>
        <GradientStop Color="#11161C" Offset="0.5"/>
        <GradientStop Color="#0B0E12" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>

    <Border BorderBrush="#1E252F" BorderThickness="1" CornerRadius="16">
      <StackPanel Margin="30,28,30,28" Spacing="18" VerticalAlignment="Center">

        <!-- Header: logo + title + status -->
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Border Width="48" Height="48" CornerRadius="13" VerticalAlignment="Center">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#19D3A8" Offset="0"/>
                <GradientStop Color="#14B994" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Border.BoxShadow>0 4 18 0 #4019D3A8</Border.BoxShadow>
            <TextBlock Text="S" Foreground="#04211A" FontSize="26" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <StackPanel VerticalAlignment="Center" Spacing="3">
            <TextBlock Text="Updating Sylnar"
                       FontSize="17" FontWeight="Bold" Foreground="#E7ECF2" />
            <TextBlock Name="StatusText"
                       Text="Preparing update..."
                       FontSize="11.5" Foreground="#9AA5B4" />
          </StackPanel>
        </StackPanel>

        <!-- Progress -->
        <StackPanel Spacing="8">
          <ProgressBar Name="Bar"
                       Minimum="0" Maximum="100" Value="0"
                       Height="6"
                       Foreground="#19D3A8"
                       Background="#1E252F"
                       IsIndeterminate="True" />
          <TextBlock Name="DetailText"
                     Text=""
                     FontSize="11" Foreground="#7A8696"
                     HorizontalAlignment="Right" />
        </StackPanel>

      </StackPanel>
    </Border>
  </Border>
</Window>
