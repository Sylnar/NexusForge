<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sylnar.Views.UpdateWindow"
        Title="Updating Sylnar"
        Width="440" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        Topmost="True"
        ShowInTaskbar="True">

  <!--
    v1.1.31: brought onto the same surface and the same brand mark as SplashWindow
    and ShutdownWindow. The composition, the size and the SetStatus/SetProgress/
    SetApplying contract in the code-behind are unchanged; only the gradient fill,
    the teal BoxShadow glow, the 16px radius and the inline colours are gone, so
    the product no longer draws two different Sylnar logos depending on which
    window you are looking at.
  -->
  <Border Background="{StaticResource BgAppBrush}"
          BorderBrush="{StaticResource LineCardBrush}"
          BorderThickness="1"
          CornerRadius="10"
          ClipToBounds="True">
    <StackPanel Margin="30,28,30,28" Spacing="18" VerticalAlignment="Center">

      <!-- Header: brand lockup + live status -->
      <StackPanel Orientation="Horizontal" Spacing="16">
        <Border Width="48" Height="48" CornerRadius="13" VerticalAlignment="Center"
                Background="{StaticResource AccentBrush}">
          <TextBlock Text="S"
                     Foreground="{StaticResource OnAccentBrush}"
                     FontSize="26" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <StackPanel VerticalAlignment="Center" Spacing="3">
          <TextBlock Text="Updating Sylnar" FontSize="17" FontWeight="Bold" />
          <TextBlock Name="StatusText"
                     Text="Preparing update..."
                     FontSize="11.5"
                     Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>
      </StackPanel>

      <!-- Progress -->
      <StackPanel Spacing="8">
        <ProgressBar Name="Bar"
                     Classes="bar"
                     Minimum="0" Maximum="100" Value="0"
                     IsIndeterminate="True" />
        <TextBlock Name="DetailText"
                   Text=""
                   Classes="caption"
                   HorizontalAlignment="Right" />
      </StackPanel>

    </StackPanel>
  </Border>
</Window>
