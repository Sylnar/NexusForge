<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="using:Sylnar.Helpers"
        x:Class="Sylnar.Views.SplashWindow"
        Title="Sylnar"
        Width="460" Height="340"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        Topmost="True"
        ShowInTaskbar="False">

  <!--
    v1.1.31: the splash is the app's own surface at window scale, not a separate
    little design that happens to share the teal. Everything here comes from
    Styles/Theme.axaml, and the brand lockup is the sidebar's (Controls/Sidebar.axaml)
    scaled on its own ratios: tile 30:8 -> 56:15, glyph 16:30 -> 30:56, wordmark
    tracking 0.06em -> 24px:1.44. Gone with it: the diagonal gradients, the teal
    BoxShadow glows and the 16px radius, none of which the product draws anywhere
    else - depth here is 1px lines and flat surface steps.

    Background stays Transparent under AcrylicBlur so the 10px corners round against
    the desktop; every pixel inside the Border is opaque. The two nested Borders this
    replaces (gradient fill outside, stroke inside) are now one.
  -->
  <Border Background="{StaticResource BgAppBrush}"
          BorderBrush="{StaticResource LineCardBrush}"
          BorderThickness="1"
          CornerRadius="10"
          ClipToBounds="True">
    <Grid RowDefinitions="*,Auto,Auto">

      <!-- Brand -->
      <StackPanel Grid.Row="0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="16"
                  Margin="0,20,0,0">

        <Border HorizontalAlignment="Center"
                Width="56" Height="56"
                CornerRadius="15"
                Background="{StaticResource AccentBrush}">
          <TextBlock Text="S"
                     Foreground="{StaticResource OnAccentBrush}"
                     FontSize="30"
                     FontWeight="Bold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <StackPanel HorizontalAlignment="Center" Spacing="4">
          <TextBlock Text="SYLNAR"
                     FontSize="24"
                     FontWeight="Bold"
                     LetterSpacing="1.44"
                     HorizontalAlignment="Center" />
          <TextBlock Text="DMA FPGA Management Tool"
                     Classes="sub"
                     HorizontalAlignment="Center" />
        </StackPanel>

      </StackPanel>

      <!-- Progress -->
      <StackPanel Grid.Row="1" Margin="48,0,48,0" Spacing="10">
        <ProgressBar Name="Progress"
                     Classes="thin"
                     Minimum="0" Maximum="100" Value="0" />
        <TextBlock Name="StatusText"
                   Text="Initializing..."
                   Classes="caption"
                   HorizontalAlignment="Center" />
      </StackPanel>

      <!-- Version footer. VersionInfo is the single source of truth; the
           code-behind no longer sets this a second time. -->
      <StackPanel Grid.Row="2"
                  HorizontalAlignment="Center"
                  Margin="0,16,0,20"
                  Orientation="Horizontal"
                  Spacing="6">
        <Ellipse Classes="dot ok" />
        <TextBlock Text="{x:Static h:VersionInfo.WithV}" Classes="mono caption" />
      </StackPanel>

    </Grid>
  </Border>
</Window>
