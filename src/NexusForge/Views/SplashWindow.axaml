<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="using:Sylnar.Helpers"
        x:Class="Sylnar.Views.SplashWindow"
        Title="Sylnar"
        Width="460" Height="340"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

  <Border CornerRadius="16"
          ClipToBounds="True">
    <Border.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#0D1015" Offset="0"/>
        <GradientStop Color="#11161C" Offset="0.5"/>
        <GradientStop Color="#0B0E12" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>

    <Border BorderBrush="#1E252F" BorderThickness="1" CornerRadius="16">
      <Grid RowDefinitions="*,Auto,Auto">

        <!-- Main content -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Margin="0,20,0,0">

          <!-- Animated logo -->
          <Border HorizontalAlignment="Center"
                  Width="72" Height="72"
                  CornerRadius="18"
                  Name="LogoBorder">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#19D3A8" Offset="0"/>
                <GradientStop Color="#14B994" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Border.BoxShadow>0 4 24 0 #4019D3A8</Border.BoxShadow>
            <TextBlock Text="S"
                       Foreground="#04211A"
                       FontSize="36"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>

          <!-- Title -->
          <StackPanel HorizontalAlignment="Center" Spacing="4">
            <TextBlock Text="SYLNAR"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#E7ECF2"
                       HorizontalAlignment="Center"
                       LetterSpacing="3" />
            <TextBlock Text="DMA FPGA Management Tool"
                       FontSize="12"
                       Foreground="#7A8696"
                       HorizontalAlignment="Center" />
          </StackPanel>

        </StackPanel>

        <!-- Progress section -->
        <StackPanel Grid.Row="1"
                    Margin="48,0,48,0"
                    Spacing="10">

          <!-- Progress bar track -->
          <Border Background="#1E252F"
                  CornerRadius="3"
                  Height="4"
                  ClipToBounds="True">
            <Border Name="ProgressFill"
                    Background="#19D3A8"
                    CornerRadius="3"
                    Height="4"
                    HorizontalAlignment="Left"
                    Width="0">
              <Border.BoxShadow>0 0 8 0 #8019D3A8</Border.BoxShadow>
            </Border>
          </Border>

          <!-- Status text -->
          <TextBlock Name="StatusText"
                     Text="Initializing..."
                     Foreground="#5E6A7A"
                     FontSize="11"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Version footer -->
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,20"
                    Orientation="Horizontal"
                    Spacing="6">
          <Ellipse Width="5" Height="5" Fill="#19D3A8" VerticalAlignment="Center" />
          <!-- v1.1.25: Text bound via x:Static so design-time preview and
               runtime both source from VersionInfo (single source of truth). -->
          <TextBlock Name="VersionText"
                     Text="{x:Static h:VersionInfo.WithV}"
                     Foreground="#5E6A7A"
                     FontSize="10" />
        </StackPanel>

      </Grid>
    </Border>
  </Border>
</Window>
