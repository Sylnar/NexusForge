<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sylnar.ViewModels"
             xmlns:ctrl="using:Sylnar.Views.Controls"
             x:Class="Sylnar.Views.Controls.BoardInfoPanel"
             x:DataType="vm:BoardInfoViewModel">

  <UserControl.Styles>
    <Style Selector="SelectableTextBlock.dna">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="0.68" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="SelectableTextBlock.dna.empty">
      <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Classes="card">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

      <!-- ── Heading + connection pill ── -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="section" Text="BOARD" />
        <Border Grid.Column="1" Classes="pill" ctrl:ToneClass.Tone="{Binding ConnectionTone}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse />
            <TextBlock Text="{Binding ConnectionStatus}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- ── Part ── -->
      <StackPanel Grid.Row="1" Spacing="2" Margin="0,14,0,0">
        <TextBlock Text="{Binding DevicePart}" FontSize="24" FontWeight="Bold" LetterSpacing="-0.24"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding DeviceSubtitle}" FontSize="12.5"
                   Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <!-- ── Details ── -->
      <Grid Grid.Row="2" Margin="0,14,0,0" ColumnDefinitions="*,16,*" RowDefinitions="Auto,10,Auto">
        <StackPanel Spacing="3">
          <TextBlock Classes="caption" Text="IDCODE" />
          <TextBlock Classes="value mono" FontWeight="Medium" Text="{Binding IdCode}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="3">
          <TextBlock Classes="caption" Text="Package" />
          <TextBlock Classes="value mono" FontWeight="Medium" Text="{Binding PackageName}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="3">
          <TextBlock Classes="caption" Text="Cable" />
          <TextBlock Classes="value" Text="{Binding CableType}" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding CableType}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="2" Spacing="3">
          <TextBlock Classes="caption" Text="Bridge" />
          <TextBlock Classes="value" Text="{Binding Bridge}" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="BSCAN SPI bridge bitstream used to reach the flash chip" />
        </StackPanel>
      </Grid>

      <!-- ── Device DNA ── -->
      <Border Grid.Row="4" Classes="inset" Margin="0,14,0,0">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Classes="overline" Text="DEVICE DNA" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding DnaHint}"
                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <SelectableTextBlock Classes="dna" Classes.empty="{Binding !HasDna}" Text="{Binding DnaDisplay}" />
            <Button Grid.Column="1" Classes="secondary sm" Margin="10,0,0,0"
                    Command="{Binding CopyDnaCommand}" ToolTip.Tip="Copy the DNA to the clipboard">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ctrl:StrokeIcon Data="{StaticResource IconCopy}" Width="13" Height="13" StrokeThickness="2" />
                <TextBlock Text="{Binding CopyDnaLabel}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>

    </Grid>
  </Border>
</UserControl>
