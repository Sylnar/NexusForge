<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sylnar.ViewModels"
             xmlns:ctrl="using:Sylnar.Views.Controls"
             x:Class="Sylnar.Views.Controls.FlashPanel"
             x:DataType="vm:FlashViewModel">

  <UserControl.Styles>
    <!-- Step bar: pending / active / done / failed -->
    <Style Selector="StackPanel.step TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}" />
    </Style>
    <Style Selector="StackPanel.step.done TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="StackPanel.step.active TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="StackPanel.step.failed TextBlock">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>
    <Style Selector="StackPanel.step.failed ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>
    <Style Selector="TextBlock.file-name.none">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- The whole card accepts a dropped .bin / .bit file -->
  <Border x:Name="Card" Classes="card" DragDrop.AllowDrop="True">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

      <!-- ── Heading + mode ── -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="section" Text="FIRMWARE" />
        <Border Grid.Column="1" Classes="pill plain" IsVisible="{Binding IsFileValid}">
          <TextBlock Text="{Binding FlashModeText}" />
        </Border>
      </Grid>

      <!-- ── File (drop zone) ── -->
      <Panel Grid.Row="1" Margin="0,14,0,0">
        <Rectangle x:Name="DropZone" Classes="dropzone" />
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="12">
          <Border Classes="icon-box">
            <ctrl:StrokeIcon Data="{StaticResource IconFile}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="2" Margin="12,0" VerticalAlignment="Center">
            <TextBlock Classes="file-name" Classes.none="{Binding !HasFile}"
                       Text="{Binding FirmwareFileName}" FontSize="13" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FirmwarePath}" />
            <TextBlock Classes="tone" ctrl:ToneClass.Tone="{Binding FileDetailTone}"
                       Text="{Binding FileDetailText}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="2" Classes="secondary sm" Padding="12,0" Content="Browse"
                  Command="{Binding BrowseFileCommand}" VerticalAlignment="Center" />
        </Grid>
      </Panel>

      <!-- ── Steps ── -->
      <ItemsControl Grid.Row="2" Margin="0,14,-8,0" ItemsSource="{Binding Steps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FlashStep">
            <StackPanel Classes="step" Spacing="6" Margin="0,0,8,0"
                        Classes.active="{Binding IsActive}"
                        Classes.done="{Binding IsDone}"
                        Classes.failed="{Binding IsFailed}">
              <ProgressBar Classes="step" Value="{Binding Progress}" />
              <TextBlock Text="{Binding Label}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ── Progress ── -->
      <StackPanel Grid.Row="3" Margin="0,14,0,0" Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding ProgressText}" FontSize="13" VerticalAlignment="Bottom"
                     Margin="0,0,0,3" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Classes="mono tone" ctrl:ToneClass.Tone="{Binding ProgressTone}"
                     Text="{Binding PercentText}" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,0" />
        </Grid>
        <ProgressBar Classes="bar" Classes.danger="{Binding IsFailedRun}"
                     Minimum="0" Maximum="100" Value="{Binding FlashPercentage}" />
        <TextBlock Classes="meta" Text="{Binding ElapsedText}" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <!-- ── Result ── -->
      <StackPanel Grid.Row="4" Margin="0,14,0,0" Spacing="8" VerticalAlignment="Top">
        <Border Classes="note ok strong" IsVisible="{Binding IsFlashComplete}">
          <Grid ColumnDefinitions="Auto,*">
            <ctrl:StrokeIcon Classes="note-icon" />
            <TextBlock Grid.Column="1" Text="{Binding FlashSuccessMessage}" />
          </Grid>
        </Border>
        <Border Classes="note danger" IsVisible="{Binding HasFlashError}">
          <Grid ColumnDefinitions="Auto,*">
            <ctrl:StrokeIcon Classes="note-icon" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{Binding FlashErrorMessage}" FontWeight="SemiBold" />
              <TextBlock Text="See the log below for the cause and what to try."
                         Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>

      <!-- ── Actions ── -->
      <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
        <TextBlock Classes="meta" Text="{Binding CancelNote}" TextWrapping="Wrap"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
        <Button Grid.Column="1" Classes="danger-outline lg" Padding="14,0" Content="Cancel"
                Command="{Binding CancelFlashCommand}" Margin="0,0,8,0" />
        <Button Grid.Column="2" Classes="primary lg" Content="{Binding FlashButtonText}"
                Command="{Binding FlashFirmwareCommand}" />
      </Grid>

    </Grid>
  </Border>
</UserControl>
