<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="using:Sylnar.Helpers"
        x:Class="Sylnar.Views.WhatsNewWindow"
        Title="{x:Static h:VersionInfo.WindowTitle}"
        Width="460" Height="286"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        ShowInTaskbar="False">
  <Border Background="{StaticResource BgAppBrush}"
          BorderBrush="{StaticResource LineCardBrush}"
          BorderThickness="1"
          CornerRadius="10"
          ClipToBounds="True">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24,22,24,20">
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
        <Border Width="30" Height="30" CornerRadius="8"
                Background="{StaticResource AccentBrush}">
          <TextBlock Text="S" FontSize="16" FontWeight="Bold"
                     Foreground="{StaticResource OnAccentBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Name="HeadingText"
                   FontSize="16" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Grid.Row="1" Name="NotesText"
                 Margin="0,20,0,0"
                 FontSize="13" LineHeight="24"
                 Foreground="{StaticResource TextSecondaryBrush}"
                 TextWrapping="Wrap" />

      <Button Grid.Row="2" Name="CloseButton"
              Classes="primary" Content="Got it"
              HorizontalAlignment="Right"
              IsDefault="True" />
    </Grid>
  </Border>
</Window>
