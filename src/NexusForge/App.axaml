<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sylnar.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <Application.Resources>
    <!-- Brand accent. Overriding the Fluent accent keys makes every stock
         control (focus rings, tab pipe, checkboxes, text-box underline,
         selection) use Sylnar teal instead of the Windows accent colour. -->
    <Color x:Key="SystemAccentColor">#00D4AA</Color>
    <Color x:Key="SystemAccentColorLight1">#1FE3BC</Color>
    <Color x:Key="SystemAccentColorLight2">#4BEBCB</Color>
    <Color x:Key="SystemAccentColorLight3">#7FF2DA</Color>
    <Color x:Key="SystemAccentColorDark1">#00B894</Color>
    <Color x:Key="SystemAccentColorDark2">#009C7E</Color>
    <Color x:Key="SystemAccentColorDark3">#007F67</Color>
    <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="#00D4AA" />

    <!-- Text selection in log / inputs -->
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#5500D4AA" />
  </Application.Resources>
</Application>
