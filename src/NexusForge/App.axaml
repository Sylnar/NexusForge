<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sylnar.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <!-- Sylnar design tokens, fonts, icons and control styles -->
    <StyleInclude Source="avares://Sylnar/Styles/Theme.axaml" />
  </Application.Styles>
  <Application.Resources>
    <!-- Brand accent. Overriding the Fluent accent keys makes every stock
         control (focus rings, checkboxes, text-box caret, selection) use the
         Sylnar teal instead of the Windows accent colour. -->
    <Color x:Key="SystemAccentColor">#19D3A8</Color>
    <Color x:Key="SystemAccentColorLight1">#3ADDB9</Color>
    <Color x:Key="SystemAccentColorLight2">#5BE6C4</Color>
    <Color x:Key="SystemAccentColorLight3">#8CF0D8</Color>
    <Color x:Key="SystemAccentColorDark1">#14B994</Color>
    <Color x:Key="SystemAccentColorDark2">#11A081</Color>
    <Color x:Key="SystemAccentColorDark3">#0E8069</Color>
  </Application.Resources>
</Application>
